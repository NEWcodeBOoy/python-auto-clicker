import threading
import time
import tkinter as tk
from tkinter import ttk, messagebox
from pynput import mouse, keyboard
import os
import sys

APP_ICON_PATH = r"C:\AutoClicker\favicon.ico"


mouse_ctrl = mouse.Controller()
kb_ctrl = keyboard.Controller()


state = {
    "running": False,
    "hold_mode": False,
    "stop_requested": False,
    "fixed_pos": None,
    "click_thread": None
}



def click_loop(interval, clicks, button_name, click_type, follow_cursor):
    btn_map = {
        "left": mouse.Button.left,
        "right": mouse.Button.right,
        "middle": mouse.Button.middle
    }
    button = btn_map.get(button_name, mouse.Button.left)

    count_done = 0
    while not state["stop_requested"]:
        if clicks and count_done >= clicks:
            break


        if state["hold_mode"]:
            if not follow_cursor and state["fixed_pos"] is not None:
                mouse_ctrl.position = state["fixed_pos"]
            try:
                mouse_ctrl.press(button)
            except Exception:
                pass

            while state["hold_mode"] and not state["stop_requested"]:
                time.sleep(0.05)
            try:
                mouse_ctrl.release(button)
            except Exception:
                pass
            continue


        for _ in range(click_type):
            if state["stop_requested"]:
                break
            if not follow_cursor and state["fixed_pos"] is not None:
                mouse_ctrl.position = state["fixed_pos"]
            try:
                mouse_ctrl.click(button, 1)
            except Exception:
                pass
            time.sleep(0.01)
        count_done += 1

        if clicks and count_done >= clicks:
            break

        waited = 0.0
        while waited < interval and not state["stop_requested"]:
            time.sleep(0.01)
            waited += 0.01

    state["running"] = False
    state["stop_requested"] = False



class AutoClickerApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("AutoClicker")


        try:

            if getattr(sys, 'frozen', False):
                base_path = sys._MEIPASS
            else:
                base_path = os.path.dirname(os.path.abspath(__file__))

            icon_path = os.path.join(base_path, "favicon.ico")

            if os.path.exists(icon_path):
                self.iconbitmap(icon_path)
            else:
                print(f"⚠️ Icon not found at {icon_path}")
        except Exception as e:
            print("Could not load icon:", e)


        self.resizable(False, False)
        self.protocol("WM_DELETE_WINDOW", self.on_close)

        main = ttk.Frame(self, padding=12)
        main.grid(row=0, column=0, sticky="nsew")


        ttk.Label(main, text="Interval (s):").grid(row=0, column=0, sticky="w")
        self.interval_var = tk.StringVar(value="0.1")
        ttk.Entry(main, textvariable=self.interval_var, width=10).grid(row=0, column=1, sticky="w")


        ttk.Label(main, text="Repeat (0=infinite):").grid(row=1, column=0, sticky="w")
        self.count_var = tk.StringVar(value="0")
        ttk.Entry(main, textvariable=self.count_var, width=10).grid(row=1, column=1, sticky="w")


        ttk.Label(main, text="Button:").grid(row=2, column=0, sticky="w")
        self.button_var = tk.StringVar(value="left")
        ttk.OptionMenu(main, self.button_var, "left", "left", "right", "middle").grid(row=2, column=1, sticky="w")


        ttk.Label(main, text="Click type:").grid(row=3, column=0, sticky="w")
        self.click_type_var = tk.IntVar(value=1)
        ttk.OptionMenu(main, self.click_type_var, 1, 1, 2, 3).grid(row=3, column=1, sticky="w")


        self.follow_var = tk.BooleanVar(value=True)
        ttk.Checkbutton(main, text="Follow cursor (unchecked = fixed position)", variable=self.follow_var).grid(row=4, column=0, columnspan=2, sticky="w")


        self.pos_label = ttk.Label(main, text="Fixed pos: Not set")
        self.pos_label.grid(row=5, column=0, columnspan=2, sticky="w", pady=(6,0))
        ttk.Button(main, text="Set Position (capture mouse now)", command=self.set_position).grid(row=6, column=0, columnspan=2, pady=(2,8))


        btn_frame = ttk.Frame(main)
        btn_frame.grid(row=7, column=0, columnspan=2, sticky="ew")
        self.start_btn = ttk.Button(btn_frame, text="Start (F5)", command=self.start_clicking)
        self.start_btn.grid(row=0, column=0, padx=(0,6))
        self.stop_btn = ttk.Button(btn_frame, text="Stop (F5)", command=self.stop_clicking, state="disabled")
        self.stop_btn.grid(row=0, column=1, padx=(6,0))
        self.hold_btn = ttk.Button(btn_frame, text="Toggle Hold (F6)", command=self.toggle_hold)
        self.hold_btn.grid(row=0, column=2, padx=(6,0))


        self.status_var = tk.StringVar(value="Idle")
        ttk.Label(main, textvariable=self.status_var).grid(row=8, column=0, columnspan=2, sticky="w", pady=(8,0))


        self.listener_thread = threading.Thread(target=self.global_listener, daemon=True)
        self.listener_thread.start()


        self.after(100, self.refresh_ui)

    def set_position(self):
        pos = mouse_ctrl.position
        state["fixed_pos"] = pos
        self.pos_label.config(text=f"Fixed pos: {pos}")

    def start_clicking(self):
        if state["running"]:
            return
        try:
            interval = float(self.interval_var.get())
            if interval < 0:
                raise ValueError("Interval must be non-negative")
        except Exception:
            messagebox.showerror("Invalid interval", "Please enter a valid number for interval (seconds).")
            return
        try:
            clicks = int(self.count_var.get())
            if clicks < 0:
                raise ValueError("Clicks must be 0 or positive")
        except Exception:
            messagebox.showerror("Invalid count", "Please enter a valid integer for repeat count (0 = infinite).")
            return

        button = self.button_var.get()
        click_type = int(self.click_type_var.get())
        follow = bool(self.follow_var.get())

        state["stop_requested"] = False
        state["running"] = True

        t = threading.Thread(target=click_loop, args=(interval, clicks, button, click_type, follow), daemon=True)
        state["click_thread"] = t
        t.start()
        self.status_var.set("Running")
        self.start_btn.config(state="disabled")
        self.stop_btn.config(state="normal")

    def stop_clicking(self):
        if not state["running"]:
            return
        state["stop_requested"] = True
        self.status_var.set("Stopping...")

    def toggle_hold(self):
        state["hold_mode"] = not state["hold_mode"]
        self.status_var.set("Hold: ON" if state["hold_mode"] else "Hold: OFF")

    def refresh_ui(self):
        if state["running"]:
            self.start_btn.config(state="disabled")
            self.stop_btn.config(state="normal")
            if state["hold_mode"]:
                self.status_var.set("Running (HOLD mode)")
            else:
                self.status_var.set("Running")
        else:
            self.start_btn.config(state="normal")
            self.stop_btn.config(state="disabled")
            if state["hold_mode"]:
                self.status_var.set("Idle (Hold ready)")
            else:
                self.status_var.set("Idle")
        self.after(150, self.refresh_ui)

    def global_listener(self):
        def on_press(key):
            try:
                if key == keyboard.Key.f5:
                    if state["running"]:
                        state["stop_requested"] = True
                    else:
                        self.after(0, self.start_clicking)
                elif key == keyboard.Key.f6:
                    self.after(0, self.toggle_hold)
            except Exception:
                pass

        with keyboard.Listener(on_press=on_press) as listener:
            listener.join()

    def on_close(self):
        state["stop_requested"] = True
        state["running"] = False
        try:
            self.destroy()
        except Exception:
            pass


if __name__ == "__main__":
    app = AutoClickerApp()
    app.mainloop()
